---
import "@workspace/ui/globals.css"
---

<!doctype html>
<html lang="en" dir="ltr" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta
      name="description"
      content="Saif-Eddine Aghoukad — full-stack developer building web and mobile products for commerce and shipping. Creator of ecart.ma and eship.ma."
    />
    <meta name="theme-color" content="#0b0b0d" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>Saif-Eddine Aghoukad — Full-stack Developer</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem("aghoukad-theme")
        document.documentElement.classList.toggle("dark", theme !== "light")
      } catch {
        // The default dark theme also works when storage is unavailable.
      }
    </script>
  </head>
  <body>
    <slot />
    <script is:inline>
      // Run after the stylesheets so CSS is the source of truth for every palette.
      ;(() => {
        const root = document.documentElement
        const themeColor = document.querySelector('meta[name="theme-color"]')
        const syncThemeColor = () => {
          themeColor?.setAttribute(
            "content",
            getComputedStyle(root).getPropertyValue("--background").trim()
          )
        }
        new MutationObserver(syncThemeColor).observe(root, {
          attributes: true,
          attributeFilter: ["class"],
        })
        window
          .matchMedia("(max-width: 767px)")
          .addEventListener("change", syncThemeColor)
        syncThemeColor()
      })()
    </script>
  </body>
</html>
